{
  "name": "@cluion/http",
  "version": "0.1.0",
  "description": "A zero-dependency HTTP client built on the native Fetch API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cluion/http.git"
  },
  "homepage": "https://github.com/cluion/http#readme",
  "bugs": "https://github.com/cluion/http/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "http",
    "fetch",
    "client",
    "cluion"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
